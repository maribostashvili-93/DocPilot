# Copy to .env (or set on the host) and fill in the values.
# Company admin and platform superadmin are separate accounts.

# Optional on first boot — creates the platform-wide superadmin account.
SUPERADMIN_EMAIL=admin@docpilot.local
SUPERADMIN_PASSWORD=SartuliSartuli
SUPERADMIN_NAME=DocPilot Superadmin

# Required on first boot — creates the company-admin user. Subsequent boots ignore this.
ADMIN_PASSWORD=replace-with-the-same-password-you-use-locally

# Optional — defaults shown. Override to match your own tenant.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Platform Admin
COMPANY_SLUG=demo
COMPANY_NAME=Demo Company

# Server bind / data location. Defaults match the Dockerfile.
DOCPILOT_HOST=0.0.0.0
DOCPILOT_PORT=4179
DOCPILOT_DATA_DIR=/app/.docpilot-data

# Set to 1 ONLY when the site is reachable via HTTPS (real cert or Cloudflare
# Flexible SSL in front). With it on under plain HTTP the browser silently
# drops the session cookie and the client area sits at the loading screen.
DOCPILOT_COOKIE_SECURE=0
